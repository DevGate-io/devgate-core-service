# PostgreSQL (docker/compose.yaml maps the container port 5432 to 5444 on the host)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devgate_core
# Container name of this service's postgres (see docker/compose.yaml); `db` is taken
# by the other services on the shared app_network.
POSTGRES_HOST=devgate-core-db
POSTGRES_PORT=5432

# JWT: this service issues the access/refresh tokens; every other service validates them
# with the same HS256 secret.
JWT_SECRET_BASE64=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# RabbitMQ (audit events are published to audit.exchange / audit.routingKey).
# Inside docker the broker is reachable by container name; use localhost only for bootRun.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# devgate-integration-service: template runs generate the repository through it.
INTEGRATION_SERVICE_URL=http://devgate-integration-service:8083
